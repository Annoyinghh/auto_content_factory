{
  "$schema": "../team/node_modules/wrangler/config-schema.json",
  "name": "acf-operations",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-09",
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": false },
  "triggers": { "crons": ["7 * * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "acf-operations-local",
      "database_id": "00000000-0000-0000-0000-000000000001",
      "migrations_dir": "migrations"
    }
  ]
}
